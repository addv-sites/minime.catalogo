{
  "name": "minime-catalogo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MINI ME — Catálogo digital premium de ropa para bebé (page-flip, mobile-first, estático)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "products:validate": "node scripts/validate-products.mjs",
    "products:generate": "node scripts/generate-products.mjs",
    "images:optimize": "python3 scripts/optimize-images.py",
    "admin": "npm run dev -- --mode admin"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pageflip": "^2.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}